# --- App ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
# Number of cluster workers (1 = single process; "max" = one per CPU core)
CLUSTER_WORKERS=1

# --- Security ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_COST=12
CORS_ORIGINS=http://localhost:3000

# --- PostgreSQL ---
DATABASE_URL=postgres://m63m:m63m_password@localhost:5432/m63m
DB_SSL=false
# Creates missing tables on boot (development only; never alters existing ones)
DB_SYNC=true
DB_LOG_SQL=false

# --- Redis / BullMQ (optional) ---
# Leave empty to run social publishing in-process without a queue.
REDIS_URL=

# --- Social auto-posting (optional; platforms without credentials are skipped and logged) ---
X_BEARER_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=
SNAPCHAT_ACCESS_TOKEN=
